/*Q4. Write a program to print the frequency of each character in the given string in the order of their first appearance.
Input Format:
• A single line containing a string representing.
Output Format:
• Print each character and its frequency on a separate line in the format:
<character>: <frequency>
Constraints:
• The string will contain only alphabets.
• The string will contain both uppercase and lowercase letters and they are treated as different characters.
*/
import java.util.LinkedHashMap;
import java.util.Map;
import java.util.Scanner;
 
public class CharFrequency {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        String s = sc.nextLine();
        Map<Character, Integer> freq = new LinkedHashMap<>();   // keeps insertion order
        for (char c : s.toCharArray()) {
            freq.put(c, freq.getOrDefault(c, 0) + 1);
        }
        for (Map.Entry<Character, Integer> e : freq.entrySet()) {
            System.out.println(e.getKey() + ": " + e.getValue());
        }
        sc.close();
    }
}
